;********** biosboot.8kn -- Plasmo machine *********
;*
;*	Post-boot entry: transfer vector, stack and PSA.
;*
;* 821013 S. Savitzky (Zilog) -- adapt for nonseg.
;* 820930 S. Savitzky (Zilog) -- created
;*
;****************************************************

;  01/12/83	Adapted for the Kontron ECB/16 Z8002 (DMH)
__text:	.sect

;****************************************************
;*
;* NOTE -- THIS CODE IS HIGHLY SYSTEM-DEPENDENT
;*
;*	This module contains the code that receives
;*	control after being booted.
;*
;*	The main function is to make sure that the 
;*	system, whose entry point is called "bios",
;*	is passed a valid stack and PSA pointer.
;*
;****************************************************



;****************************************************
;*
;* Externals
;*
;****************************************************

	.global	bios
	.global _wboot
	.global _psap

;****************************************************
;*
;* Constants
;*
;****************************************************


SYSTEM	.equ	00000000h	; system address (the image is loaded at 0)
;* System-Lo/Hi layout (port $85 = 01, System-Hi is the OS's own RAM):
;*   0x0000-~0x93C0 code+data+bss (cpm.flat; the Makefile checks it ends
;*                  below SYSPSA)
;*   0xB000         PSA (trap vectors, 256-byte aligned)
;*   ..0xBF00       system stack (grows down toward the PSA)
;* The PSA must lie above the whole image INCLUDING bss: trapinit writes the
;* trap entries at SYSPSA+4..+0x17, and anything in the bss there (e.g. the
;* CCP's _dma buffer) would overwrite the trap vectors at run time.
SYSSTK	.equ	0BF00h		; system stack top
SYSPSA	.equ	0B000h		; system PSA (above the OS image + bss)



;****************************************************
;*
;* Entry Points and post-boot Initialization
;*
;****************************************************


;* transfer vector 

	jr	entry			; offset 0: cold boot
	jr	wboot			; offset 2: warm boot
	jr	entry			; offset 4

;* post-boot init
;* The system image has been loaded at 0 and port $85 is at its reset
;* value (01, System-Hi = its own RAM).  Set up the stack + PSA and enter
;* the BIOS.  The system runs where it was loaded (no relocation).

entry:	DI	VI,NVI
	ld	r15, #SYSSTK	; init stack pointer
	ld	r3, #SYSPSA	; PSA location
	ldctl	psap, r3	; set the CPU PSAP register
	ld	_psap, r3	; and the BIOS _psap variable (trapinit fills here)
	ld	r3,#bios
	jp	@r3		; enter the BIOS cold boot

wboot:	ld	r3,#_wboot
	jp	@r3

